# ── LLM Engine (Groq) ──
# Required: Obtain a free API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Email / SMTP Configuration ──
# Optional: Required for sending real password reset emails.
# If omitted or left blank, reset links will be safely logged to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_letter_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="TaxCopilot"

# ── Application URL ──
# URL where the frontend is hosted (used for generating password reset links)
APP_URL=http://localhost:3000
